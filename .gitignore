__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# raw and processed data are large and not meant for git — see data/README.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# raw per-row prediction dumps (tens of MB, reproducible from a GPU rerun) -
# the JSON summaries and figures derived from them are what's kept
reports/*.npz

# experiment logs / model artifacts
experiments/*
!experiments/.gitkeep
*.mlflow/
mlruns/

.env

# Office lock files (created while a .docx/.xlsx/.pptx is open)
~$*
